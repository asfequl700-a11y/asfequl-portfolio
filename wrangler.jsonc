{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hellofahim",
	// Live addresses. Cloudflare creates the DNS records and HTTPS certificate itself.
	"routes": [
		{ "pattern": "hellofahim.com", "custom_domain": true },
		{ "pattern": "www.hellofahim.com", "custom_domain": true }
	],
	"compatibility_date": "2026-11-14",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"no_handle_cross_request_promise_resolution"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hellofahim"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Blog: posts live in D1, uploaded images in R2
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hellofahim-blog",
			"database_id": "e1157a8a-c63f-4921-ab24-5ed82308ba2d",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "BLOG_IMAGES", "bucket_name": "hellofahim-blog-images" }
	]
}